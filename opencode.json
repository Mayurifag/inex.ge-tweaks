{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "enabled": false
    },
    "agent-browser": {
      "type": "local",
      "command": ["/opt/homebrew/bin/npx", "-y", "agent-browser-mcp"],
      "enabled": true,
      "env": {
        "AGENT_BROWSER_PATH": "/opt/homebrew/bin/agent-browser",
        "AGENT_BROWSER_EXECUTABLE_PATH": "/Applications/Helium.app/Contents/MacOS/Helium",
        "AGENT_BROWSER_PROFILE": "/Users/mayurifag/Code/inex.ge-tweaks/browser-data",
        "AGENT_BROWSER_HEADED": "true",
        "AGENT_BROWSER_DEFAULT_TIMEOUT": "5000",
        "AGENT_BROWSER_ARGS": "--no-first-run,--no-default-browser-check"
      }
    }
  }
}
