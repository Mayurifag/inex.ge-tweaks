{
  "name": "inex.ge-tweaks",
  "version": "0.1.13",
  "private": true,
  "description": "Userscript tweaks for inex.ge.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && cp src/dark.user.css dist/dark.user.css",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.js\" \"scripts/**/*.test.mjs\"",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "smoke:build": "npm run build && node scripts/check-build.mjs",
    "format": "npm run formatting",
    "formatting": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.0.14",
    "vite-plugin-monkey": "^8.0.5"
  }
}
